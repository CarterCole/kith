{
  "description": "Cedar value conversion vectors (spec \u00a74.2). 'json' is JSON text. 'cedar' is the Cedar value every implementation must build from it: a Long (a JSON integer here), a String, or a record or set of those. 'cedar' is absent when the value is dropped.",
  "values": [
    { "json": "12", "cedar": 12, "note": "an integer of magnitude at most 2^53 - 1 is a Long" },
    { "json": "12.0", "cedar": 12, "note": "by value, not spelling" },
    { "json": "1.2e1", "cedar": 12 },
    { "json": "-0.0", "cedar": 0, "note": "negative zero is the Long 0" },
    { "json": "9007199254740991", "cedar": 9007199254740991, "note": "2^53 - 1, the largest Long" },
    { "json": "-9007199254740991", "cedar": -9007199254740991 },
    { "json": "12.5", "cedar": "12.5", "note": "any other number is a String" },
    { "json": "-12.50", "cedar": "-12.5", "note": "the text does not keep the spelling" },
    { "json": "0.1", "cedar": "0.1" },
    { "json": "0.1000000000000000055511151231257827", "cedar": "0.1", "note": "shortest digits that read back as the same double" },
    { "json": "0.30000000000000004", "cedar": "0.30000000000000004" },
    { "json": "1.0000000000000002", "cedar": "1.0000000000000002" },
    { "json": "1259144888929591.25", "cedar": "1259144888929591.2", "note": "two shortest candidates are equally near: the even digit wins" },
    { "json": "0.000001", "cedar": "0.000001", "note": "decimal exponent -6: the smallest written plainly" },
    { "json": "1.234e-6", "cedar": "0.000001234" },
    { "json": "0.00001234", "cedar": "0.00001234" },
    { "json": "0.0000001", "cedar": "1e-7", "note": "decimal exponent -7: the largest written with an exponent" },
    { "json": "1.5e-7", "cedar": "1.5e-7" },
    { "json": "0.0000001234", "cedar": "1.234e-7" },
    { "json": "-2.5E-10", "cedar": "-2.5e-10" },
    { "json": "5e-324", "cedar": "5e-324", "note": "the smallest double" },
    { "json": "9007199254740992", "cedar": "9007199254740992", "note": "2^53 is not a Long" },
    { "json": "9007199254740993", "cedar": "9007199254740992", "note": "beyond 2^53 - 1: the text of the nearest double, not the exact digits" },
    { "json": "-9007199254740993", "cedar": "-9007199254740992" },
    { "json": "18446744073709551615", "cedar": "18446744073709552000", "note": "2^64 - 1" },
    { "json": "123456789012345680000", "cedar": "123456789012345680000", "note": "decimal exponent 20: the largest written plainly" },
    { "json": "100000000000000000000.5", "cedar": "100000000000000000000" },
    { "json": "1e21", "cedar": "1e+21", "note": "decimal exponent 21: the smallest written with an exponent" },
    { "json": "999999999999999999999", "cedar": "1e+21", "note": "rounds to the double 10^21" },
    { "json": "1.5e300", "cedar": "1.5e+300" },
    { "json": "1E300", "cedar": "1e+300" },
    { "json": "1.7976931348623157e308", "cedar": "1.7976931348623157e+308", "note": "the largest double" },
