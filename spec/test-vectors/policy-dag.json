          "did:kith:ada",
          "group:contractors"
        ]
      },
      "staff": {
        "members": [],
        "rule": "principal has email && principal.email like \"*@acme.test\""
      },
      "strong": {
        "members": [],
        "rule": "principal has aal && principal.aal >= 2"
      },
      "vip": {
        "members": [],
        "rule": "principal in Role::\"billing-admin\""
      }
    },
    "roles": {
