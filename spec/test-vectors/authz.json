{
  "description": "Kith authorization conformance vectors. Every implementation must compute the same memberships and decisions.",
  "bundle": {
    "version": 1,
    "groups": {
      "finance": { "members": ["did:kith:ada", "group:contractors"] },
      "contractors": { "members": ["did:kith:bob"] },
      "staff": { "rule": "principal has email && principal.email like \"*@acme.test\"" },
      "strong": { "rule": "principal has aal && principal.aal >= 2" },
      "vip": { "rule": "principal in Role::\"billing-admin\"" }
    },
    "roles": {
      "billing-reader": { "members": ["group:finance"] },
      "billing-admin": { "rule": "principal in Group::\"finance\" && principal in Group::\"strong\"" }
    },
    "directory": {
      "did:kith:ada": { "attrs": { "email": "ada@acme.test", "department": "finance" } },
      "did:kith:bob": { "attrs": { "email": "bob@partner.test" } }
    },
    "policies": "@id(\"read-invoices\")\npermit(principal in Role::\"billing-reader\", action == Action::\"Query.invoices\", resource);\n@id(\"pay\")\npermit(principal in Role::\"billing-admin\", action == Action::\"Mutation.payInvoice\", resource) when { context has amount && context.amount < 10000 };\n@id(\"own-invoice\")\npermit(principal, action == Action::\"Invoice.read\", resource) when { principal has email && resource has ownerEmail && resource.ownerEmail == principal.email };\n@id(\"no-delegated-pay\")\nforbid(principal, action == Action::\"Mutation.payInvoice\", resource) when { context has actor };"
  },
  "memberships": [
    { "id": "did:kith:ada", "attrs": { "aal": 2 }, "groups": ["finance", "staff", "strong", "vip"], "roles": ["billing-admin", "billing-reader"] },
    { "id": "did:kith:ada", "attrs": { "aal": 1 }, "groups": ["finance", "staff"], "roles": ["billing-reader"] },
    { "id": "did:kith:bob", "attrs": { "aal": 3 }, "groups": ["contractors", "finance", "strong", "vip"], "roles": ["billing-admin", "billing-reader"] },
    { "id": "did:kith:eve", "attrs": { "aal": 3, "email": "eve@acme.test" }, "groups": ["staff", "strong"], "roles": [] },
    { "id": "did:kith:mallory", "attrs": {}, "groups": [], "roles": [] },
    { "id": "did:kith:ada", "attrs": { "aal": 2.0 }, "groups": ["finance", "staff", "strong", "vip"], "roles": ["billing-admin", "billing-reader"] }
  ],
  "decisions": [
    { "name": "reader lists invoices", "principal": "did:kith:ada", "attrs": { "aal": 1 }, "action": "Query.invoices", "resource": { "type": "Operation", "id": "Query.invoices" }, "context": {}, "allowed": true },
    { "name": "stranger cannot list", "principal": "did:kith:eve", "attrs": { "aal": 3, "email": "eve@acme.test" }, "action": "Query.invoices", "resource": { "type": "Operation", "id": "Query.invoices" }, "context": {}, "allowed": false },
    { "name": "admin pays under limit", "principal": "did:kith:ada", "attrs": { "aal": 2 }, "action": "Mutation.payInvoice", "resource": { "type": "Operation", "id": "Mutation.payInvoice" }, "context": { "amount": 500 }, "allowed": true },
    { "name": "admin over limit", "principal": "did:kith:ada", "attrs": { "aal": 2 }, "action": "Mutation.payInvoice", "resource": { "type": "Operation", "id": "Mutation.payInvoice" }, "context": { "amount": 50000 }, "allowed": false },
    { "name": "weak session is not admin", "principal": "did:kith:ada", "attrs": { "aal": 1 }, "action": "Mutation.payInvoice", "resource": { "type": "Operation", "id": "Mutation.payInvoice" }, "context": { "amount": 5 }, "allowed": false },
    { "name": "row level: own invoice (float attr ignored safely)", "principal": "did:kith:ada", "attrs": { "aal": 1 }, "action": "Invoice.read", "resource": { "type": "Invoice", "id": "inv_1", "attrs": { "ownerEmail": "ada@acme.test", "amount": 12.5, "note": null } }, "context": {}, "allowed": true },
    { "name": "row level: someone else's invoice", "principal": "did:kith:bob", "attrs": { "aal": 1 }, "action": "Invoice.read", "resource": { "type": "Invoice", "id": "inv_1", "attrs": { "ownerEmail": "ada@acme.test" } }, "context": {}, "allowed": false },
    { "name": "delegated: cap allows query", "principal": "did:kith:ada", "attrs": { "aal": 2 }, "actor": "did:kith:agent", "caps": [{ "action": "Query.*" }], "action": "Query.invoices", "resource": { "type": "Operation", "id": "Query.invoices" }, "context": {}, "allowed": true },
    { "name": "delegated: cap missing", "principal": "did:kith:ada", "attrs": { "aal": 2 }, "actor": "did:kith:agent", "caps": [{ "action": "Query.*" }], "action": "Invoice.read", "resource": { "type": "Invoice", "id": "inv_1", "attrs": { "ownerEmail": "ada@acme.test" } }, "context": {}, "allowed": false },
    { "name": "delegated: cap present but policy forbids", "principal": "did:kith:ada", "attrs": { "aal": 2 }, "actor": "did:kith:agent", "caps": [{ "action": "*" }], "action": "Mutation.payInvoice", "resource": { "type": "Operation", "id": "Mutation.payInvoice" }, "context": { "amount": 5 }, "allowed": false },
    { "name": "an integral float is an integer", "principal": "did:kith:ada", "attrs": { "aal": 2.0 }, "action": "Mutation.payInvoice", "resource": { "type": "Operation", "id": "Mutation.payInvoice" }, "context": { "amount": 500.0 }, "allowed": true },
    { "name": "a resource id with non-ASCII, quotes, a backslash and an emoji", "principal": "did:kith:ada", "attrs": { "aal": 1 }, "action": "Invoice.read", "resource": { "type": "Invoice", "id": "inv_\u00fc \"1\" \\ \ud83d\ude00", "attrs": { "ownerEmail": "ada@acme.test" } }, "context": {}, "allowed": true },
    { "name": "delegated: a cap on a non-ASCII resource prefix allows it", "principal": "did:kith:ada", "attrs": { "aal": 1 }, "actor": "did:kith:agent", "caps": [{ "action": "Invoice.*", "resource": "Invoice::\"inv_\u00fc*" }], "action": "Invoice.read", "resource": { "type": "Invoice", "id": "inv_\u00fc1", "attrs": { "ownerEmail": "ada@acme.test" } }, "context": {}, "allowed": true },
    { "name": "delegated: the ASCII look-alike prefix does not", "principal": "did:kith:ada", "attrs": { "aal": 1 }, "actor": "did:kith:agent", "caps": [{ "action": "Invoice.*", "resource": "Invoice::\"inv_u*" }], "action": "Invoice.read", "resource": { "type": "Invoice", "id": "inv_\u00fc1", "attrs": { "ownerEmail": "ada@acme.test" } }, "context": {}, "allowed": false }
  ],
  "entities": {
    "description": "Resource hierarchy and typed values (spec §4.2.1, §4.2.2). A resource may carry 'parents' and 'related' entities. A decision that is false includes every case where the request cannot be built: an implementation may report an error there, and must not allow.",
    "bundle": {
      "version": 1,
      "roles": { "reader": { "members": ["did:kith:ada"] } },
      "directory": {
        "did:kith:ada": { "attrs": { "email": "ada@acme.test" } },
        "did:kith:bob": { "attrs": { "email": "bob@partner.test" } }
      },
      "policies": "@id(\"folder-read\")\npermit(principal in Role::\"reader\", action == Action::\"Document.read\", resource in Folder::\"finance\");\n@id(\"owner\")\npermit(principal, action == Action::\"Document.read\", resource) when { resource has owner && resource.owner == principal };\n@id(\"folder-owner\")\npermit(principal, action == Action::\"Document.read\", resource) when { principal has email && resource has folder && resource.folder has ownerEmail && resource.folder.ownerEmail == principal.email };\n@id(\"no-archive\")\nforbid(principal, action, resource in Folder::\"archive\");\n@id(\"office-only\")\npermit(principal, action == Action::\"Query.audit\", resource) when { context has sourceIp && context.sourceIp.isInRange(ip(\"10.0.0.0/8\")) };\n@id(\"before-close\")\npermit(principal, action == Action::\"Query.report\", resource) when { context has now && context.now < datetime(\"2030-01-01\") };\n@id(\"small\")\npermit(principal, action == Action::\"Invoice.approve\", resource) when { resource has amount && resource.amount.lessThan(decimal(\"100.00\")) };"
    },
    "decisions": [
      {"name": "hierarchy: a document in the folder", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "finance"}]}, "context": {}, "allowed": true},
      {"name": "hierarchy: a document with no parents", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1"}, "context": {}, "allowed": false},
      {"name": "hierarchy: through a sub-folder the request describes", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "q3"}], "related": [{"type": "Folder", "id": "q3", "parents": [{"type": "Folder", "id": "finance"}]}]}, "context": {}, "allowed": true},
      {"name": "hierarchy: a sub-folder nobody described leads nowhere", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "q3"}]}, "context": {}, "allowed": false},
      {"name": "hierarchy: a forbid on an ancestor wins", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "q3"}], "related": [{"type": "Folder", "id": "q3", "parents": [{"type": "Folder", "id": "finance"}, {"type": "Folder", "id": "archive"}]}]}, "context": {}, "allowed": false},
      {"name": "hierarchy: the folder role is still needed", "principal": "did:kith:bob", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "finance"}]}, "context": {}, "allowed": false},
      {"name": "entity value: the owner is the principal", "principal": "did:kith:bob", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "attrs": {"owner": {"__entity": {"type": "User", "id": "did:kith:bob"}}}}, "context": {}, "allowed": true},
      {"name": "entity value: the owner is someone else", "principal": "did:kith:bob", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "attrs": {"owner": {"__entity": {"type": "User", "id": "did:kith:ada"}}}}, "context": {}, "allowed": false},
      {"name": "entity value: a string is not an entity", "principal": "did:kith:bob", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "attrs": {"owner": "did:kith:bob"}}, "context": {}, "allowed": false},
      {"name": "entity value: an attribute of a related entity", "principal": "did:kith:bob", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "attrs": {"folder": {"__entity": {"type": "Folder", "id": "f9"}}}, "related": [{"type": "Folder", "id": "f9", "attrs": {"ownerEmail": "bob@partner.test"}}]}, "context": {}, "allowed": true},
      {"name": "entity value: the related entity was not supplied", "principal": "did:kith:bob", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "attrs": {"folder": {"__entity": {"type": "Folder", "id": "f9"}}}}, "context": {}, "allowed": false},
      {"name": "entity value: a malformed reference is not an entity", "principal": "did:kith:bob", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "attrs": {"owner": {"__entity": {"type": "User"}}}}, "context": {}, "allowed": false},
      {"name": "ip: inside the range", "principal": "did:kith:bob", "attrs": {}, "action": "Query.audit", "resource": {"type": "Operation", "id": "Query.audit"}, "context": {"sourceIp": {"__extn": {"fn": "ip", "arg": "10.1.2.3"}}}, "allowed": true},
      {"name": "ip: outside the range", "principal": "did:kith:bob", "attrs": {}, "action": "Query.audit", "resource": {"type": "Operation", "id": "Query.audit"}, "context": {"sourceIp": {"__extn": {"fn": "ip", "arg": "192.0.2.7"}}}, "allowed": false},
      {"name": "ip: a string is not an address", "principal": "did:kith:bob", "attrs": {}, "action": "Query.audit", "resource": {"type": "Operation", "id": "Query.audit"}, "context": {"sourceIp": "10.1.2.3"}, "allowed": false},
      {"name": "ip: a malformed address is refused", "principal": "did:kith:bob", "attrs": {}, "action": "Query.audit", "resource": {"type": "Operation", "id": "Query.audit"}, "context": {"sourceIp": {"__extn": {"fn": "ip", "arg": "10.1.2.300"}}}, "allowed": false},
      {"name": "typed value: an unknown constructor is refused", "principal": "did:kith:bob", "attrs": {}, "action": "Query.audit", "resource": {"type": "Operation", "id": "Query.audit"}, "context": {"sourceIp": {"__extn": {"fn": "ipaddr", "arg": "10.1.2.3"}}}, "allowed": false},
      {"name": "datetime: before the deadline", "principal": "did:kith:bob", "attrs": {}, "action": "Query.report", "resource": {"type": "Operation", "id": "Query.report"}, "context": {"now": {"__extn": {"fn": "datetime", "arg": "2029-12-31T23:59:59Z"}}}, "allowed": true},
      {"name": "datetime: after the deadline", "principal": "did:kith:bob", "attrs": {}, "action": "Query.report", "resource": {"type": "Operation", "id": "Query.report"}, "context": {"now": {"__extn": {"fn": "datetime", "arg": "2030-01-01T00:00:01Z"}}}, "allowed": false},
      {"name": "datetime: a string is not a datetime", "principal": "did:kith:bob", "attrs": {}, "action": "Query.report", "resource": {"type": "Operation", "id": "Query.report"}, "context": {"now": "2029-12-31T23:59:59Z"}, "allowed": false},
      {"name": "decimal: under the limit", "principal": "did:kith:bob", "attrs": {}, "action": "Invoice.approve", "resource": {"type": "Invoice", "id": "inv_1", "attrs": {"amount": {"__extn": {"fn": "decimal", "arg": "12.50"}}}}, "context": {}, "allowed": true},
      {"name": "decimal: over the limit", "principal": "did:kith:bob", "attrs": {}, "action": "Invoice.approve", "resource": {"type": "Invoice", "id": "inv_1", "attrs": {"amount": {"__extn": {"fn": "decimal", "arg": "250.00"}}}}, "context": {}, "allowed": false},
      {"name": "decimal: a JSON number is not a decimal", "principal": "did:kith:bob", "attrs": {}, "action": "Invoice.approve", "resource": {"type": "Invoice", "id": "inv_1", "attrs": {"amount": 12.5}}, "context": {}, "allowed": false},
      {"name": "conflict: a related entity may not restate the principal", "principal": "did:kith:bob", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "finance"}], "related": [{"type": "User", "id": "did:kith:bob", "parents": [{"type": "Role", "id": "reader"}]}]}, "context": {}, "allowed": false},
      {"name": "conflict: a related entity may not restate the resource", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "finance"}], "related": [{"type": "Document", "id": "d1"}]}, "context": {}, "allowed": false},
      {"name": "conflict: a related entity may not be a role", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "finance"}], "related": [{"type": "Role", "id": "other"}]}, "context": {}, "allowed": false},
      {"name": "conflict: a related entity may not be a group", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "finance"}], "related": [{"type": "Group", "id": "other"}]}, "context": {}, "allowed": false},
      {"name": "conflict: a related entity may not be an action", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "finance"}], "related": [{"type": "Action", "id": "Document.read", "parents": [{"type": "Action", "id": "all"}]}]}, "context": {}, "allowed": false},
      {"name": "conflict: a related entity given twice", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "finance"}], "related": [{"type": "Folder", "id": "q3"}, {"type": "Folder", "id": "q3"}]}, "context": {}, "allowed": false},
      {"name": "a related user who is not the principal is fine", "principal": "did:kith:ada", "attrs": {}, "action": "Document.read", "resource": {"type": "Document", "id": "d1", "parents": [{"type": "Folder", "id": "finance"}], "attrs": {"owner": {"__entity": {"type": "User", "id": "did:kith:bob"}}}, "related": [{"type": "User", "id": "did:kith:bob", "attrs": {"email": "bob@partner.test"}}]}, "context": {}, "allowed": true}
    ]
  },
  "assume": {
    "description": "Assumable roles (spec §4.3.1). 'assumptions' give the memberships of a session that assumes 'role', with the sets in 'excluded' revoked, or the reason it is refused. In 'decisions', a refused assumption denies. Every bundle in 'invalid' must fail to load.",
    "bundle": {"version": 1, "groups": {"oncall": {"members": ["did:kith:ada"]}, "contractors": {"members": ["did:kith:bob"]}, "strong": {"rule": "principal has aal && principal.aal >= 2"}, "audited": {"description": "Everyone holding break-glass, so a forbid can name them", "members": ["role:break-glass"]}, "elevated": {"rule": "principal in Role::\"break-glass\""}}, "roles": {"god": {"description": "Held, never assumed", "members": ["did:kith:root"]}, "reader": {"members": ["group:oncall"]}, "break-glass": {"assume": {"rule": "(principal in Group::\"oncall\" || principal in Group::\"contractors\") && principal in Group::\"strong\"", "max_age": 600}}, "auditor": {"assume": {"members": ["did:kith:bob", "role:reader"]}}}, "policies": "@id(\"god\")\npermit(principal in Role::\"god\", action, resource);\n@id(\"read\")\npermit(principal in Role::\"reader\", action == Action::\"Query.invoices\", resource);\n@id(\"break-glass-delete\")\npermit(principal in Role::\"break-glass\", action == Action::\"Mutation.deleteInvoice\", resource);\n@id(\"audit\")\npermit(principal in Role::\"auditor\", action == Action::\"Query.audit\", resource);\n@id(\"no-contractor-delete\")\nforbid(principal in Group::\"contractors\", action == Action::\"Mutation.deleteInvoice\", resource);\n@id(\"break-glass-drop\")\npermit(principal in Role::\"break-glass\", action in [Action::\"Mutation.dropDb\", Action::\"Mutation.dropTable\"], resource);\n@id(\"audited-no-drop-db\")\nforbid(principal in Group::\"audited\", action == Action::\"Mutation.dropDb\", resource);\n@id(\"elevated-no-drop-table\")\nforbid(principal in Group::\"elevated\", action == Action::\"Mutation.dropTable\", resource);"},
    "assumptions": [
      {"id": "did:kith:ada", "attrs": {"aal": 2}, "role": "break-glass", "groups": ["audited", "elevated", "oncall", "strong"], "roles": ["break-glass", "reader"], "note": "added to the roles the principal holds; sets that list the role, or whose rule names it, are computed with it held"},
      {"id": "did:kith:ada", "attrs": {"aal": 1}, "role": "break-glass", "refused": "not_eligible", "note": "the rule needs Group::strong"},
      {"id": "did:kith:bob", "attrs": {"aal": 2}, "role": "break-glass", "groups": ["audited", "contractors", "elevated", "strong"], "roles": ["break-glass"]},
      {"id": "did:kith:bob", "attrs": {"aal": 1}, "role": "auditor", "groups": ["contractors"], "roles": ["auditor"], "note": "listed by id"},
      {"id": "did:kith:ada", "attrs": {"aal": 1}, "role": "auditor", "groups": ["oncall"], "roles": ["auditor", "reader"], "note": "through a role the principal holds"},
      {"id": "did:kith:eve", "attrs": {"aal": 3}, "role": "auditor", "refused": "not_eligible"},
      {"id": "did:kith:root", "attrs": {"aal": 3}, "role": "god", "refused": "not_assumable", "note": "a role with no assume setting is never assumed, even by its members"},
      {"id": "did:kith:ada", "attrs": {"aal": 3}, "role": "god", "refused": "not_assumable"},
      {"id": "did:kith:ada", "attrs": {"aal": 3}, "role": "reader", "refused": "not_assumable", "note": "held roles are not assumable"},
      {"id": "did:kith:ada", "attrs": {"aal": 3}, "role": "oncall", "refused": "not_assumable", "note": "a group is not a role"},
      {"id": "did:kith:ada", "attrs": {"aal": 3}, "role": "nosuch", "refused": "not_assumable"},
      {"id": "did:kith:ada", "attrs": {"aal": 2}, "role": "break-glass", "excluded": ["Role::break-glass"], "refused": "not_eligible", "note": "revoked from the role"},
      {"id": "did:kith:ada", "attrs": {"aal": 2}, "role": "break-glass", "excluded": ["Group::oncall"], "refused": "not_eligible", "note": "revoked from what the rule needs"},
      {"id": "did:kith:ada", "attrs": {"aal": 1}, "role": "auditor", "excluded": ["Role::reader"], "refused": "not_eligible"}
    ],
    "decisions": [
      {"name": "assumed: break-glass may delete", "principal": "did:kith:ada", "attrs": {"aal": 2}, "assume": "break-glass", "action": "Mutation.deleteInvoice", "resource": {"type": "Operation", "id": "Mutation.deleteInvoice"}, "context": {}, "allowed": true},
      {"name": "standing: the same person may not", "principal": "did:kith:ada", "attrs": {"aal": 2}, "action": "Mutation.deleteInvoice", "resource": {"type": "Operation", "id": "Mutation.deleteInvoice"}, "context": {}, "allowed": false},
      {"name": "assumed: held roles still apply", "principal": "did:kith:ada", "attrs": {"aal": 2}, "assume": "break-glass", "action": "Query.invoices", "resource": {"type": "Operation", "id": "Query.invoices"}, "context": {}, "allowed": true},
      {"name": "assumed: a forbid on a group still applies", "principal": "did:kith:bob", "attrs": {"aal": 2}, "assume": "break-glass", "action": "Mutation.deleteInvoice", "resource": {"type": "Operation", "id": "Mutation.deleteInvoice"}, "context": {}, "allowed": false},
      {"name": "assumed: auditor may audit", "principal": "did:kith:bob", "attrs": {"aal": 1}, "assume": "auditor", "action": "Query.audit", "resource": {"type": "Operation", "id": "Query.audit"}, "context": {}, "allowed": true},
      {"name": "standing: auditor is not held", "principal": "did:kith:bob", "attrs": {"aal": 1}, "action": "Query.audit", "resource": {"type": "Operation", "id": "Query.audit"}, "context": {}, "allowed": false},
      {"name": "refused: an assumption that fails decides nothing", "principal": "did:kith:ada", "attrs": {"aal": 1}, "assume": "break-glass", "action": "Mutation.deleteInvoice", "resource": {"type": "Operation", "id": "Mutation.deleteInvoice"}, "context": {}, "allowed": false},
      {"name": "refused: god cannot be assumed", "principal": "did:kith:ada", "attrs": {"aal": 3}, "assume": "god", "action": "Query.audit", "resource": {"type": "Operation", "id": "Query.audit"}, "context": {}, "allowed": false},
      {"name": "standing: god is held by its members", "principal": "did:kith:root", "attrs": {"aal": 1}, "action": "Query.audit", "resource": {"type": "Operation", "id": "Query.audit"}, "context": {}, "allowed": true},
      {"name": "assumed: a forbid on a set that lists the role applies", "principal": "did:kith:ada", "attrs": {"aal": 2}, "assume": "break-glass", "action": "Mutation.dropDb", "resource": {"type": "Operation", "id": "Mutation.dropDb"}, "context": {}, "allowed": false},
      {"name": "assumed: a forbid on a set whose rule names the role applies", "principal": "did:kith:ada", "attrs": {"aal": 2}, "assume": "break-glass", "action": "Mutation.dropTable", "resource": {"type": "Operation", "id": "Mutation.dropTable"}, "context": {}, "allowed": false}
